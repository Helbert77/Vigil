# Configuração de Ambiente - Vigil App
# Copie este arquivo para .env.local e configure as variáveis necessárias

# ===== SUPABASE CONFIGURATION =====
# URL do projeto Supabase
SUPABASE_URL=your_supabase_project_url

# Chave anônima do Supabase (pode ser exposta no frontend)
SUPABASE_ANON_KEY=your_supabase_anon_key

# Chave de serviço do Supabase (NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===== API KEYS (BACKEND ONLY) =====
# Chave da API Gemini (Google AI) - USAR APENAS EM EDGE FUNCTIONS
GEMINI_API_KEY=your_gemini_api_key

# Chave da API Perspective (Google) - USAR APENAS EM EDGE FUNCTIONS
PERSPECTIVE_API_KEY=your_perspective_api_key

# ===== FRONTEND CONFIGURATION =====
# URL do frontend (para CORS e redirecionamentos)
FRONTEND_URL=http://localhost:5173

# Ambiente de desenvolvimento
NODE_ENV=development

# ===== SECURITY NOTES =====
# 1. NUNCA commite arquivos .env com chaves reais
# 2. Use apenas SUPABASE_URL e SUPABASE_ANON_KEY no frontend
# 3. Todas as outras chaves devem ser usadas apenas em Edge Functions
# 4. Configure as variáveis de ambiente no painel do Supabase para produção
# 5. Use diferentes chaves para desenvolvimento e produção

# ===== RATE LIMITING =====
# Configurações de rate limiting (podem ser ajustadas conforme necessário)
# Estes valores são usados nas Edge Functions
RATE_LIMIT_CONTENT_MODERATION_HOURLY=100
RATE_LIMIT_CONTENT_GENERATION_HOURLY_FREE=10
RATE_LIMIT_CONTENT_GENERATION_HOURLY_PREMIUM=50